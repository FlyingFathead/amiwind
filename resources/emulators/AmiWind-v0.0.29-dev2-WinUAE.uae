blitter_cycle_exact=false
cycle_exact=false
immediate_blits=false
cachesize=8192
compfpu=true
chipmem_size=4
fastmem_size=0
z3mem_size=16
z3mem_start=0x40000000
bogomem_size=0
a3000mem_size=0
mem25bit_size=0
joyport0=mouse
joyport1=none
sound_output=exact
sound_channels=stereo
sound_frequency=44100
sound_max_buff=16384
sound_interpol=anti
sound_filter=emulated
sound_volume=0
