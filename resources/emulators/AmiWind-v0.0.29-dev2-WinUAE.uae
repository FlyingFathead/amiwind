config_description=AmiWind v0.0.29-dev2 Windows reference profile | AGA 040/FPU | 2M Chip + 16M Z3 | JIT/max | select owned ROM and HDF
config_hardware=true
config_host=true
config_version=6.0.3
use_gui=yes
kickstart_rom_file=
kickstart_ext_rom_file=
floppy0=
floppy1=
floppy1type=-1
floppy2=
floppy3=
nr_floppies=1
chipset=aga
chipset_compatible=A1200
ntsc=false
cpu_model=68040
