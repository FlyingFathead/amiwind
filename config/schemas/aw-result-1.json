{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aw-result-1",
  "title": "AmiWind master builder result (aw-result-1)",
  "description": "The answer to one aw-request-1: how it went, with numbers, artifacts, logs and timings. Written by tools/aw.py; see docs/AW.md.",
  "type": "object",
  "required": ["schema", "request_id", "kind", "status", "version", "commit", "run_name", "time", "started", "finished",
               "seconds", "numbers", "steps", "failed_steps", "artifacts", "logs", "timings", "reuse", "leases"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "aw-result-1"},
    "request_id": {"type": "string", "minLength": 1},
    "kind": {"enum": ["gate", "build", "miniwind", "chimport-region", "smoke"]},
    "status": {"enum": ["passed", "failed", "refused"]},
    "version": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(-[A-Za-z0-9.]+)?$"},
    "commit": {"type": "string", "pattern": "^([0-9a-f]{4,40}|nogit)$"},
    "run_name": {"type": "string", "pattern": "^[0-9]{4}_[0-9]{2}_[0-9]{2}_v[0-9]+\\.[0-9]+\\.[0-9]+(-[A-Za-z0-9.]+)?_[A-Za-z0-9][A-Za-z0-9.-]*_([0-9a-f]{4,40}|nogit)$"},
    "time": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2} [+-][0-9]{4}$"},
    "started": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2} [+-][0-9]{4}$"},
    "finished": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2} [+-][0-9]{4}$"},
    "seconds": {"type": "number", "minimum": 0},
    "numbers": {
      "type": "object",
      "additionalProperties": {"type": ["integer", "null"]},
      "properties": {
        "tests_run": {"type": ["integer", "null"], "minimum": 0},
        "failures": {"type": ["integer", "null"], "minimum": 0},
        "errors": {"type": ["integer", "null"], "minimum": 0},
        "skipped": {"type": ["integer", "null"], "minimum": 0},
        "unexpected_skips": {"type": ["integer", "null"], "minimum": 0},
        "engine_warnings": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "steps": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["exit", "ok"],
        "properties": {
          "exit": {"type": ["integer", "null"]},
          "ok": {"type": "boolean"},
          "detail": {"type": "string"}
        }
      }
    },
    "failed_steps": {"type": "array", "items": {"type": "string"}},
    "failures": {"type": "array", "items": {"type": "string"}},
    "artifacts": {"type": "array", "items": {"type": "string"}},
    "logs": {"type": "array", "items": {"type": "string"}},
    "timings": {"type": "object"},
    "reuse": {"type": "object", "required": ["applicable"], "properties": {"applicable": {"type": "boolean"}}},
    "leases": {"type": "array", "items": {"type": "string"}},
    "gate": {"type": ["integer", "null"]},
    "head": {"type": ["string", "null"]},
    "script_exit": {"type": ["integer", "null"]},
    "notes": {"type": "array", "items": {"type": "string"}},
    "requester": {"type": "string"},
    "reason": {"type": "string"},
    "dry_run": {"type": "boolean"},
    "commands": {"type": "array", "items": {"type": "string"}},
    "stair_walk": {"type": "object", "description": "A passed build's stair-walk records marked master-checked (tools/stair_records.py promote): reports, marked, already, changed, missing, reused, walked"},
    "cores": {"type": "object", "description": "The build's machine-wide core lease (aw core leases): priority, wanted, leased (= --jobs and --cpus), host_threads, lease, rebalanced"},
    "perf_guard": {"type": "object", "description": "The perf guard's verdict on a build (tools/perf_guard.py show --json): verdict, failed, waived, busy, sections, failing, waivers"},
    "failed_stage": {"type": ["string", "null"]},
    "inputs": {"type": "array", "items": {"type": "object", "required": ["path"],
                                           "properties": {"path": {"type": "string"},
                                                          "sha256": {"type": ["string", "null"]}}}},
    "override": {"type": ["object", "null"]},
    "refusals": {"type": "array", "items": {"type": "string"}},
    "recipe": {
      "type": ["object", "null"],
      "description": "The build recipe: the one the request carried (requested: name, sha256, file) and, for a passed build, the checked-in recipe the server wrote next to this result (path)",
      "additionalProperties": false,
      "properties": {"requested": {"type": ["object", "null"]}, "path": {"type": "string"}}
    }
  }
}
